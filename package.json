{
  "name": "cortex",
  "version": "0.2.10",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Cortex — Agentic OS control plane (desktop + local web)",
  "author": "Cortex",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/fix-node-pty.cjs",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k -n next,electron -c cyan,magenta \"next dev -H 127.0.0.1 -p 3000\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:build": "npm run build && node scripts/prepare-standalone.cjs && electron-builder --mac",
    "desktop:pack": "npm run desktop:build",
    "jarvis:proxy": "node scripts/jarvis-chat-proxy.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.37.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "^18.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "node-pty": "^1.1.0",
    "openai": "^7.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "ai.cortex.os",
    "productName": "Cortex",
    "copyright": "Copyright © Cortex",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node-pty/**/*",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "desktop-runtime",
        "to": "standalone",
        "filter": [
          "**/*",
          "!node_modules/**/*",
          "!.next/node_modules/**/*",
          "!desktop-runtime/**/*",
          "!dist-desktop/**/*",
          "!dist/**/*",
          "!.git/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cortex uses the microphone for built-in voice-to-text when writing ideas and prompts.",
        "NSSpeechRecognitionUsageDescription": "Cortex can use speech recognition for voice-to-text input."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Cortex"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  }
}
