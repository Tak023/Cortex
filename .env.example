# SpaceXAI / xAI — enables live Grok (concepts + Jarvis hybrid live answers)
# https://console.x.ai
XAI_API_KEY=

# Optional Grok model for Jarvis chat (default: grok-4.5)
# JARVIS_GROK_MODEL=grok-4.5

# Jarvis chat routing:
#   hybrid (default) — LM Studio for private chat; Grok for live/current questions
#   local            — LM Studio / Ollama only (still injects web search when possible)
#   grok             — always use Grok when XAI_API_KEY is set
JARVIS_CHAT_MODE=hybrid

# Optional future adapters
# ANTHROPIC_API_KEY=

# OpenJarvis — https://github.com/open-jarvis/OpenJarvis
# Install: curl -fsSL https://open-jarvis.github.io/OpenJarvis/install.sh | bash
# Then: jarvis serve --port 8000
# JARVIS_BASE_URL=http://127.0.0.1:8000
# JARVIS_CLI=jarvis
# Interactive chat prefers LM Studio (below) over jarvis serve
# JARVIS_CHAT_BASE_URL=http://127.0.0.1:1234
# JARVIS_CHAT_MODEL=gulan28/Hermes-3-Llama-3.1-8B-abliterated-GGUF

# MCP servers (Jarvis / agents tools) — set keys then enable in Cortex → Settings / MCP
# Firecrawl — scrape / crawl web pages for agents
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Tavily — live web search injected into Jarvis prompts (news, weather, current facts)
# https://app.tavily.com/home
TAVILY_API_KEY=
# BRAVE_API_KEY=
# GitHub MCP — repos, issues, PRs (classic PAT: ghp_… or fine-grained github_pat_…)
# https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
# Playwright MCP needs no key (uses local browsers via npx @playwright/mcp)

# Optional: faster / higher-quality built-in voice-to-text (Whisper API)
# Without this, Cortex uses an on-device Whisper model (first use downloads it).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=          # e.g. http://127.0.0.1:1234/v1 for LM Studio
# WHISPER_API_KEY=
# WHISPER_BASE_URL=
# WHISPER_MODEL=whisper-1
