# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/dist-desktop
/dist
/desktop-runtime

# electron build resources (icons) — keep tracked
# /build is intentionally not ignored

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cortex local state
/data

# External clones / local installs (not part of the app source tree)
/RivalSearchMCP/
/hermes-second-brain/

# Optional local Python venvs
.venv/
**/.venv/
